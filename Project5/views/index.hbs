<h1>{{title}}</h1>
<p>Welcome to {{title}}</p>

<div>
    <form action="/insert" method="post">
        <label for="userName">User Name</label>
        <input type="text" name="userName" placeholder="enter your name">
        <br><br>
        <label for="userMail">User Mail</label>
        <input type="email" name="userMail" placeholder="enter your mail">
        <br><br>
        <input type="submit" value="submit">
    </form>
</div>

<br>
<hr>
<br>

<div> Get all users</div>
<div>
    <form action="/getusers" method="get">
    <br><br>
        <button type="submit" class="btn btn-primary">get users</button>
        <br>
        <br>
        <div>
            {{#each users}}
            <div>
                ID: {{this._id}}
            </div>
            <div>
                userName: {{this.userName}}
            </div>
            <div>
                userMail: {{this.userMail}}
            </div>
            <br><br>
            {{/each}}
        </div>
    </form>
</div>

<br><br><hr>
<dir>Update user</dir>
<div>
    <form action="/update" method="post">
        <label for="ID">ID</label>
        <input type="text" name="id" placeholder="enter id">
        <br><br>
        <label for="userName">User Name</label>
        <input type="text" name="userName" placeholder="enter your name">
        <br><br>
        <label for="userMail">User Mail</label>
        <input type="email" name="userMail" placeholder="enter your mail">
        <br><br>
        <input type="submit" value="update">
    </form>
</div>

<br><br>
<hr>
<dir>Delete user</dir>
<div>
    <form action="/delete" method="post">
        <label for="ID">ID</label>
        <input type="text" name="id" placeholder="enter id">
        <br><br>
        <input type="submit" value="delete">
    </form>
</div>

