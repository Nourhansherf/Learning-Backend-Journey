<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <title><%= title %></title>
</head>
<body>
    <div class="container">
        <br><br>
        <a href="/notes">&larr; Back</a>
        <h2>Edit Note</h2>
        <form action="/notes/edit-note/<%= note._id %>?_method=PUT" method="POST">
            <div class="form-group">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" value="<%= note.title %>" required>
            </div>
            <div class="form-group">
                <label for="body">Content:</label>
                <textarea id="body" name="body" rows="5" required><%= note.body %></textarea>
            </div>
            <button type="submit" class="btn">Save</button>
        </form>
        <footer>
            <br><hr><br>
            &copy; <%= new Date().getFullYear();  %> Noura . Built with NodeJs & MongoDB
        </footer>
    </div>
</body>
</html>
