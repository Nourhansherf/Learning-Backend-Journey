<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <title><%= title %></title>
</head>
<body>
    <div class="container">
        <div class="admin-title">
            <h2>Notes</h2>
            <a href="/notes/add-note" class="button">+ Add New</a>
        </div>

        <!-- we will add the notes listing here later -->
        <ul class="admin-posts">
            <% data.forEach(note => { %>
             <li>
                <a href="/note/<%= note._id %>">
                    <%= note.title %> &nearr;
                </a>
                <div class="admin-post-controls">
                    <a href="/edit-note/<%= note._id %>" class="btn">Edit</a>

                    <form action="/delete-note/<%= note._id %>?_method=DELETE" method="post">
                        <input type="submit" value="Delete" class="btn-delete btn">
                    </form>
                </div>
             </li>
            <% }) %>
        </ul>

        <footer class="footer">
            <br><hr><br>
            &copy; <%= new Date().getFullYear();  %> Noura . Built with NodeJs & MongoDB
        </footer>
    </div>
</body>
</html>